{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/remix-builder"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "250mb",
        "includeFiles": "backend/**"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index" }
  ]
}
